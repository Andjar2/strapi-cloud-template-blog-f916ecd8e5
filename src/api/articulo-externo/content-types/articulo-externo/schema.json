{
  "kind": "collectionType",
  "collectionName": "articulo_externos",
  "info": {
    "singularName": "articulo-externo",
    "pluralName": "articulo-externos",
    "displayName": "ArticulosExternos"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "contenido": {
      "type": "richtext"
    },
    "url_original": {
      "type": "text",
      "required": true
    },
    "nombre_fuente": {
      "type": "string"
    },
    "date_published": {
      "type": "datetime"
    },
    "url_imagen_cover": {
      "type": "text"
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "articulos_externos"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
